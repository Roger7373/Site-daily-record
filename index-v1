<!doctype html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="theme-color" content="#111827">
<meta name="description" content="工地工人日勤、OT、预支薪水和月尾薪资">
<link rel="manifest" href="/Site-daily-record/manifest.json">
<title>Site Daily Record</title>
<style>
*{box-sizing:border-box}
body{margin:0;font-family:Arial,sans-serif;background:#f3f4f6;color:#111827;padding-bottom:75px}
header{background:#111827;color:white;padding:18px 16px;position:sticky;top:0;z-index:10}
header h1{margin:0;font-size:21px} header p{margin:5px 0 0;color:#d1d5db;font-size:13px}
.container{max-width:950px;margin:auto;padding:15px}.page{display:none}.page.active{display:block}
.card{background:white;border-radius:12px;padding:15px;margin-bottom:15px;box-shadow:0 2px 8px rgba(0,0,0,.06)}
.card h2{margin:0 0 12px;font-size:18px}
button{border:0;border-radius:8px;padding:10px 14px;font-size:14px;cursor:pointer}
.btn-primary{background:#2563eb;color:white}.btn-green{background:#16a34a;color:white}.btn-red{background:#dc2626;color:white}
.btn-gray{background:#e5e7eb;color:#111827}.btn-orange{background:#ea580c;color:white}
.btn-purple{background:#7c3aed;color:white}
input,select{width:100%;padding:10px;border:1px solid #d1d5db;border-radius:8px;font-size:15px;margin-top:5px}
label{display:block;margin-bottom:12px;font-size:14px;font-weight:bold}
.grid{display:grid;grid-template-columns:repeat(2,1fr);gap:10px}
@media(min-width:700px){.grid{grid-template-columns:repeat(4,1fr)}}
.stat{background:#f9fafb;border-radius:10px;padding:12px;text-align:center}.stat-title{color:#6b7280;font-size:12px}
.stat-value{font-size:20px;font-weight:bold;margin-top:4px}.worker{border:1px solid #e5e7eb;border-radius:10px;padding:12px;margin-bottom:10px}
.worker-name{font-size:17px;font-weight:bold}.worker-info{color:#6b7280;font-size:13px;margin-top:4px}
.worker-actions{display:flex;gap:7px;margin-top:10px;flex-wrap:wrap}
.att-row{border-bottom:1px solid #e5e7eb;padding:12px 0}.att-name{font-weight:bold;margin-bottom:8px}
.att-buttons{display:flex;gap:6px;flex-wrap:wrap}.att-btn{padding:7px 10px;font-size:13px}
.att-present{background:#dcfce7;color:#166534}.att-off{background:#fef3c7;color:#92400e}.att-absent{background:#fee2e2;color:#991b1b}
.att-selected{outline:3px solid #2563eb}.ot-box{margin-top:8px;display:flex;align-items:center;gap:8px}.ot-box input{width:90px;margin:0}
/* 总出勤：电脑默认显示完整表格 */
.attendance-summary-mobile{
  display:none;
}

/* 手机总出勤卡片 */
@media(max-width:699px){
  .attendance-summary-mobile{
    display:block;
  }

  .attendance-summary-desktop{
    display:none;
  }

  .attendance-worker-card{
    background:#fff;
    border:1px solid #e5e7eb;
    border-radius:14px;
    padding:14px;
    margin-bottom:12px;
    box-shadow:0 2px 8px rgba(0,0,0,.05);
  }

  .attendance-worker-name{
    font-size:18px;
    font-weight:bold;
    margin-bottom:10px;
  }

  .attendance-worker-stats{
    display:flex;
    flex-wrap:wrap;
    gap:6px 12px;
    font-size:13px;
    margin-bottom:12px;
  }

  .mobile-days{
    display:grid;
    grid-template-columns:repeat(7,1fr);
    gap:6px;
  }

  .mobile-day{
    text-align:center;
    border-radius:8px;
    padding:6px 2px;
    font-size:11px;
  }

  .mobile-day span{
    display:block;
    margin-bottom:2px;
  }

  .mobile-day b{
    font-size:16px;
  }

  .mobile-day-present{
    background:#dcfce7;
    color:#166534;
  }

  .mobile-day-absent{
    background:#fee2e2;
    color:#991b1b;
  }

  .mobile-day-unrecorded{
    background:#f3f4f6;
    color:#6b7280;
  }
}

/* 打印 / PDF 永远使用完整表格 */
@media print{
  .attendance-summary-mobile{
    display:none!important;
  }

  .attendance-summary-desktop{
    display:block!important;
  }
}
.table-wrap{overflow-x:auto}table{width:100%;border-collapse:collapse;min-width:650px}th,td{padding:9px;border-bottom:1px solid #e5e7eb;text-align:left;font-size:13px}th{background:#f9fafb}
.total{font-size:20px;font-weight:bold}.empty{text-align:center;color:#6b7280;padding:25px 10px}
.bottom-nav{position:fixed;bottom:0;left:0;right:0;height:65px;background:white;border-top:1px solid #ddd;display:flex;justify-content:center;z-index:20;box-shadow:0 -2px 8px rgba(0,0,0,.08)}
.nav-btn{flex:1;max-width:180px;background:white;color:#6b7280;border-radius:0;padding:7px 2px;font-size:12px}.nav-btn.active{color:#2563eb;font-weight:bold}
.nav-icon{font-size:20px;display:block;margin-bottom:2px}
.modal{display:none;position:fixed;inset:0;background:rgba(0,0,0,.5);z-index:100;align-items:center;justify-content:center;padding:15px}.modal.show{display:flex}
.modal-box{background:white;border-radius:14px;padding:18px;width:100%;max-width:500px;max-height:90vh;overflow:auto}.modal-title{font-size:19px;font-weight:bold;margin-bottom:15px}
.month-row{display:flex;gap:10px;align-items:end;flex-wrap:wrap}.month-row label{flex:1;min-width:150px}
.small{font-size:12px;color:#6b7280}.amount{font-weight:bold}.danger-zone{border:1px solid #fecaca;background:#fff7f7}
.report-title{text-align:center;margin-bottom:12px}.report-meta{text-align:center;color:#6b7280;font-size:13px;margin-bottom:15px}
.report-actions{display:flex;gap:8px;flex-wrap:wrap;margin-top:15px}
.daily-present{color:#166534;font-weight:bold}.daily-off{color:#92400e}.daily-absent{color:#991b1b}.daily-unrecorded{color:#6b7280;font-weight:bold}
@media print{
  body{background:white;padding:0}.no-print,header,.bottom-nav{display:none!important}.print-area{display:block!important}
  .card{box-shadow:none;border:1px solid #ddd;page-break-inside:avoid}.container{max-width:none;padding:0}
  table{min-width:0}th,td{font-size:11px;padding:6px}
}
</style>
</head>
<body>
<header><h1>🏗️ Site Daily Record</h1><p>工人日勤 · OT · 预支薪水 · 月尾结算</p></header>

<div class="container">
<section id="page-workers" class="page active">
  <div class="card"><div style="display:flex;justify-content:space-between;align-items:center;gap:10px">
    <div><h2>👷 工人名单</h2><div class="small">管理工人和每日工资</div></div>
    <button class="btn-primary" onclick="openWorkerModal()">＋ 添加工人</button>
  </div></div>
  <div id="workersList"></div>
</section>

<section id="page-attendance" class="page">
  <div class="card"><h2>📅 每日日勤</h2>
    <label>日期<input type="date" id="attendanceDate" onchange="renderAttendance()"></label>
    <div class="small">出勤 = 有工资　|　休息 = 无工资　|　缺勤 = 无工资</div>
  </div>
  <div class="card"><div id="attendanceList"></div></div>
</section>

<section id="page-salary" class="page">
  <div class="card"><h2>💰 薪资</h2>
    <label>结算月份<input type="month" id="salaryMonth" onchange="renderSalary()"></label>
  </div>
  <div id="salaryList"></div>
</section>

<section id="page-summary" class="page">
  <div class="card"><h2>📊 月尾结算</h2>
    <label>结算月份<input type="month" id="summaryMonth" onchange="renderSummary()"></label>
  </div>
  <div id="summaryContent"></div>
  <div class="card no-print">
  <h2>📤 结算报告</h2>
  <div class="small" style="margin-bottom:10px">
    可打印、保存 PDF、复制或直接转发给 WhatsApp。
  </div>

  <button class="btn-primary" onclick="printSummary()">
    🖨️ 打印 / 保存 PDF
  </button>

  <button class="btn-primary" onclick="copySummaryReport()">
    📋 复制报告
  </button>

  <button class="btn-primary" onclick="shareSummaryReport()">
    📤 转发报告
  </button>
</div>
  <div class="card danger-zone no-print"><h2>⚠️ 数据管理</h2>
    <p class="small">清除后，工人、日勤、预支薪水及工资修改资料都会被删除。</p>
    <button class="btn-red" onclick="clearAllData()">清除全部资料</button>
  </div>
</section>

<section id="page-personal" class="page">
  <div class="card">
    <h2>👤 个人日勤表</h2>
    <div class="month-row">
      <label>工人<select id="personalWorker" onchange="renderPersonalAttendance()"></select></label>
      <label>月份<input type="month" id="personalMonth" onchange="renderPersonalAttendance()"></label>
    </div>
    <div class="small">可打印、保存 PDF、复制或分享给 WhatsApp 等。</div>
  </div>
  <div id="personalReport"></div>
</section>
  <section id="page-attendance-summary" class="page">
  <div class="card">
    <h2>👥 总出勤</h2>

    <div class="month-row">
      <label>月份
        <input type="month" id="attendanceSummaryMonth" onchange="renderAttendanceSummary()">
      </label>
    </div>

    <div class="small">
      ✓ 出勤　✕ 缺勤　? 未记录
    </div>
  </div>

  <div id="attendanceSummaryContent"></div>

  <div class="card no-print">
    <h2>📤 出勤表</h2>

    <div class="report-actions">
      <button class="btn-primary" onclick="printAttendanceSummary()">
        🖨️ 打印 / 保存 PDF
      </button>

      <button class="btn-green" onclick="copyAttendanceSummary()">
        📋 复制出勤表
      </button>

      <button class="btn-purple" onclick="shareAttendanceSummary()">
        📤 转发出勤表
      </button>
    </div>
  </div>
</section>
</div>

<div class="bottom-nav">
<button class="nav-btn active" id="nav-workers" onclick="showPage('workers')"><span class="nav-icon">👷</span>工人</button>
<button class="nav-btn" id="nav-attendance" onclick="showPage('attendance')"><span class="nav-icon">📅</span>日勤</button>
<button class="nav-btn" id="nav-salary" onclick="showPage('salary')"><span class="nav-icon">💰</span>薪资</button>
<button class="nav-btn" id="nav-summary" onclick="showPage('summary')"><span class="nav-icon">📊</span>结算</button>
<button class="nav-btn" id="nav-attendance-summary" onclick="showPage('attendance-summary')"><span class="nav-icon">👥</span>总出勤</button>
  <button class="nav-btn" id="nav-personal" onclick="showPage('personal')"><span class="nav-icon">👤</span>个人</button>
</div>

<div class="modal" id="workerModal"><div class="modal-box">
<div class="modal-title" id="workerModalTitle">添加工人</div>
<label>工人姓名<input id="workerName" placeholder="例如：Ali"></label>
<label>每日工资 RM<input id="workerDailyRate" type="number" step="0.01" placeholder="例如：80"></label>
<label>OT 每小时 RM<input id="workerOTRate" type="number" step="0.01" placeholder="例如：12"></label>
<div style="display:flex;gap:8px;justify-content:flex-end"><button class="btn-gray" onclick="closeWorkerModal()">取消</button><button class="btn-primary" id="workerSaveBtn" onclick="saveWorker()">保存</button></div>
</div></div>

<div class="modal" id="advanceModal"><div class="modal-box">
<div class="modal-title">预支薪水</div><div id="advanceWorkerName" style="font-weight:bold;margin-bottom:12px"></div>
<label>日期<input type="date" id="advanceDate"></label>
<label>预支金额 RM<input type="number" id="advanceAmount" step="0.01" placeholder="例如：100"></label>
<div style="display:flex;gap:8px;justify-content:flex-end"><button class="btn-gray" onclick="closeAdvanceModal()">取消</button><button class="btn-orange" onclick="addAdvance()">添加预支</button></div>
</div></div>

<script>
const WORKER_KEY="siteWorkers";
const ATT_KEY="siteAttendance";
const ADVANCE_KEY="siteAdvances";
const SALARY_KEY="siteSalaryOverrides";

let workers=JSON.parse(localStorage.getItem(WORKER_KEY)||"[]");
let attendance=JSON.parse(localStorage.getItem(ATT_KEY)||"{}");
let advances=JSON.parse(localStorage.getItem(ADVANCE_KEY)||"[]");
let salaryOverrides=JSON.parse(localStorage.getItem(SALARY_KEY)||"{}");

let selectedAdvanceWorker=null;
let editingWorkerId=null;

function saveData(){
  localStorage.setItem(WORKER_KEY,JSON.stringify(workers));
  localStorage.setItem(ATT_KEY,JSON.stringify(attendance));
  localStorage.setItem(ADVANCE_KEY,JSON.stringify(advances));
  localStorage.setItem(SALARY_KEY,JSON.stringify(salaryOverrides));
}

function showPage(page){
  document.querySelectorAll(".page").forEach(e=>e.classList.remove("active"));
  document.getElementById("page-"+page).classList.add("active");
  document.querySelectorAll(".nav-btn").forEach(e=>e.classList.remove("active"));
  document.getElementById("nav-"+page).classList.add("active");
  if(page==="workers")renderWorkers();
  if(page==="attendance")renderAttendance();
  if(page==="salary")renderSalary();
  if(page==="summary")renderSummary();
  if(page==="attendance-summary")renderAttendanceSummary();
  if(page==="personal"){renderPersonalWorkerOptions();renderPersonalAttendance();}
}

function getToday(){
  const d=new Date(),y=d.getFullYear(),m=String(d.getMonth()+1).padStart(2,"0"),day=String(d.getDate()).padStart(2,"0");
  return `${y}-${m}-${day}`;
}
function getMonth(){return getToday().slice(0,7)}
function money(v){return Number(v||0).toFixed(2)}
function escapeHTML(v){return String(v).replaceAll("&","&amp;").replaceAll("<","&lt;").replaceAll(">","&gt;").replaceAll('"',"&quot;").replaceAll("'","&#039;")}

function openWorkerModal(){
  editingWorkerId=null;
  document.getElementById("workerModalTitle").textContent="添加工人";
  document.getElementById("workerSaveBtn").textContent="添加";
  document.getElementById("workerName").value="";
  document.getElementById("workerDailyRate").value="";
  document.getElementById("workerOTRate").value="";
  document.getElementById("workerModal").classList.add("show");
}
function editWorker(id){
  const w=workers.find(x=>x.id===id); if(!w)return;
  editingWorkerId=id;
  document.getElementById("workerModalTitle").textContent="编辑工人";
  document.getElementById("workerSaveBtn").textContent="保存修改";
  document.getElementById("workerName").value=w.name;
  document.getElementById("workerDailyRate").value=w.dailyRate;
  document.getElementById("workerOTRate").value=w.otRate;
  document.getElementById("workerModal").classList.add("show");
}
function closeWorkerModal(){document.getElementById("workerModal").classList.remove("show");editingWorkerId=null}
function saveWorker(){
  const name=document.getElementById("workerName").value.trim();
  const dailyRate=Number(document.getElementById("workerDailyRate").value);
  const otRate=Number(document.getElementById("workerOTRate").value);
  if(!name){alert("请输入工人姓名");return}
  if(!Number.isFinite(dailyRate)||dailyRate<=0){alert("请输入正确的每日工资");return}
  if(!Number.isFinite(otRate)||otRate<0){alert("请输入正确的 OT 工资");return}
  if(editingWorkerId){
    const w=workers.find(x=>x.id===editingWorkerId);
    if(w){w.name=name;w.dailyRate=dailyRate;w.otRate=otRate}
  }else{
    workers.push({id:Date.now().toString(),name,dailyRate,otRate});
  }
  saveData();closeWorkerModal();renderWorkers();renderPersonalWorkerOptions();
}
function deleteWorker(id){
  const w=workers.find(x=>x.id===id);if(!w)return;
  if(!confirm("确定要删除 "+w.name+" 吗？"))return;
  workers=workers.filter(x=>x.id!==id);
  saveData();renderWorkers();renderPersonalWorkerOptions();
}
function renderWorkers(){
  const box=document.getElementById("workersList");
  if(!workers.length){box.innerHTML='<div class="card empty">还没有工人<br><br>点击「＋ 添加工人」开始</div>';return}
  box.innerHTML=workers.map(w=>`
    <div class="card worker">
      <div class="worker-name">${escapeHTML(w.name)}</div>
      <div class="worker-info">Daily：RM ${money(w.dailyRate)} &nbsp;·&nbsp; OT：RM ${money(w.otRate)}/小时</div>
      <div class="worker-actions">
        <button class="btn-orange" onclick="openAdvanceModal('${w.id}')">＋ 预支薪水</button>
        <button class="btn-gray" onclick="editWorker('${w.id}')">✏️ 编辑</button>
        <button class="btn-red" onclick="deleteWorker('${w.id}')">删除</button>
      </div>
    </div>`).join("");
}

function getAttendanceKey(date,id){return date+"_"+id}
function getAttendance(id,date){return attendance[getAttendanceKey(date,id)]||{status:"unrecorded",ot:0}}
function setAttendance(id,date,status){
  const key=getAttendanceKey(date,id),old=attendance[key]||{};
  attendance[key]={status,ot:Number(old.ot||0)};saveData();renderAttendance();
}
function setOT(id,date,value){
  const key=getAttendanceKey(date,id),old=attendance[key]||{status:"present",ot:0};
  attendance[key]={status:old.status||"present",ot:Number(value)||0};saveData();
}
function renderAttendance(){
  const date=document.getElementById("attendanceDate").value||getToday(),box=document.getElementById("attendanceList");
  if(!workers.length){box.innerHTML='<div class="empty">请先到「工人」添加工人</div>';return}
  box.innerHTML=workers.map(w=>{
    const d=getAttendance(w.id,date);
    return `<div class="att-row">
      <div class="att-name">${escapeHTML(w.name)}</div>
      <div class="att-buttons">
        <button class="att-btn att-present ${d.status==="present"?"att-selected":""}" onclick="setAttendance('${w.id}','${date}','present')">✓ 出勤</button>
        <button class="att-btn att-off ${d.status==="off"?"att-selected":""}" onclick="setAttendance('${w.id}','${date}','off')">休息</button>
        <button class="att-btn att-absent ${d.status==="absent"?"att-selected":""}" onclick="setAttendance('${w.id}','${date}','absent')">缺勤</button>
      </div>
      <div class="ot-box"><span>OT 小时：</span><input type="number" min="0" step="0.5" value="${Number(d.ot||0)}" onchange="setOT('${w.id}','${date}',this.value)"></div>
    </div>`}).join("");
}

function getMonthData(workerId,month){
  let presentDays=0,otHours=0;
  Object.keys(attendance).forEach(key=>{
    if(!key.startsWith(month+"-")||!key.endsWith("_"+workerId))return;
    const d=attendance[key];
    if(d.status==="present")presentDays++;
    otHours+=Number(d.ot||0);
  });
  return {presentDays,otHours};
}
function getAdvance(workerId,month){
  return advances.filter(a=>a.workerId===workerId&&a.date&&a.date.startsWith(month)).reduce((s,a)=>s+Number(a.amount||0),0);
}
function getPreviousDebt(workerId,month){
  let debt=0;const months=new Set();
  Object.keys(attendance).forEach(k=>{const d=k.split("_")[0];if(d&&d.length>=7)months.add(d.slice(0,7))});
  advances.forEach(a=>{if(a.workerId===workerId&&a.date)months.add(a.date.slice(0,7))});
  Array.from(months).filter(m=>m<month).sort().forEach(m=>{
    const w=workers.find(x=>x.id===workerId);if(!w)return;
    const d=getMonthData(workerId,m);
    const earnings=d.presentDays*Number(w.dailyRate)+d.otHours*Number(w.otRate);
    debt=Math.max(0,debt+getAdvance(workerId,m)-earnings);
  });
  return debt;
}
function calculateSalary(worker,month){
  const d=getMonthData(worker.id,month);
  const basePay=d.presentDays*Number(worker.dailyRate);
  const otPay=d.otHours*Number(worker.otRate);
  const currentAdvance=getAdvance(worker.id,month);
  const previousDebt=getPreviousDebt(worker.id,month);
  const calculatedEarnings=basePay+otPay;
  const key=worker.id+"_"+month;
  const totalEarnings=Object.prototype.hasOwnProperty.call(salaryOverrides,key)?Number(salaryOverrides[key]):calculatedEarnings;
  const totalDeduction=previousDebt+currentAdvance;
  const net=Math.max(0,totalEarnings-totalDeduction);
  const outstandingDebt=Math.max(0,totalDeduction-totalEarnings);
  return {presentDays:d.presentDays,otHours:d.otHours,basePay,otPay,advance:currentAdvance,previousDebt,calculatedEarnings,totalEarnings,net,outstandingDebt};
}
function editSalary(workerId,month){
  const w=workers.find(x=>x.id===workerId);if(!w)return;
  const key=workerId+"_"+month;
  const current=Object.prototype.hasOwnProperty.call(salaryOverrides,key)?Number(salaryOverrides[key]):calculateSalary(w,month).totalEarnings;
  const value=prompt(w.name+" - "+month+"\n\n修改本月工资（基本 + OT）RM：",current);
  if(value===null)return;
  const amount=Number(value);
  if(!Number.isFinite(amount)||amount<0){alert("请输入正确的工资金额");return}
  salaryOverrides[key]=amount;saveData();renderSalary();renderSummary();
}

function openAdvanceModal(workerId){
  const w=workers.find(x=>x.id===workerId);if(!w)return;
  selectedAdvanceWorker=workerId;
  document.getElementById("advanceWorkerName").textContent=w.name;
  document.getElementById("advanceDate").value=getToday();
  document.getElementById("advanceAmount").value="";
  document.getElementById("advanceModal").classList.add("show");
}
function closeAdvanceModal(){document.getElementById("advanceModal").classList.remove("show");selectedAdvanceWorker=null}
function addAdvance(){
  if(!selectedAdvanceWorker)return;
  const date=document.getElementById("advanceDate").value,amount=Number(document.getElementById("advanceAmount").value);
  if(!date){alert("请选择日期");return}
  if(!Number.isFinite(amount)||amount<=0){alert("请输入正确的预支金额");return}
  advances.push({id:Date.now().toString(),workerId:selectedAdvanceWorker,date,amount});
  saveData();closeAdvanceModal();renderSalary();renderSummary();
}
function showWorkerSalary(workerId,month){
  const w=workers.find(x=>x.id===workerId);if(!w)return;
  const records=advances.filter(a=>a.workerId===workerId&&a.date&&a.date.startsWith(month));
  if(!records.length){alert(w.name+" - "+month+"\n\n没有预支记录");return}
  let text=w.name+" - "+month+"\n\n";
  records.forEach((a,i)=>text+=(i+1)+". "+a.date+"   RM "+money(a.amount)+"\n");
  text+="\n总预支：RM "+money(getAdvance(workerId,month));
  alert(text);
  const choice=prompt("要编辑或删除哪一笔预支？\n\n输入编号，例如：1\n取消则不操作");
  if(choice===null)return;
  const index=Number(choice)-1;
  if(!Number.isInteger(index)||!records[index]){alert("编号无效");return}
  const record=records[index],action=prompt("请选择操作：\n\nE = 编辑\nD = 删除");
  if(action===null)return;
  if(action.toUpperCase()==="D"){
    if(!confirm("确定要删除这笔预支吗？\n\n"+record.date+"   RM "+money(record.amount)))return;
    const real=advances.findIndex(a=>a.id===record.id);
    if(real!==-1){advances.splice(real,1);saveData();renderSalary();renderSummary();alert("预支记录已删除")}
    return;
  }
  if(action.toUpperCase()==="E"){
    const newDate=prompt("修改日期：",record.date);if(newDate===null)return;
    const newAmount=prompt("修改预支金额 RM：",record.amount);if(newAmount===null)return;
    const amount=Number(newAmount);
    if(!newDate){alert("日期不能为空");return}
    if(!Number.isFinite(amount)||amount<=0){alert("请输入正确的预支金额");return}
    record.date=newDate;record.amount=amount;saveData();renderSalary();renderSummary();alert("预支记录已修改");return;
  }
  alert("请输入 E 或 D");
}

